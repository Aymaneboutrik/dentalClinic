{
  "info": {
    "name": "Patient Service - Secretary API",
    "description": "Tests Postman pour la partie Secrétaire (Gestion patients et documents)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gestion Patients",
      "item": [
        {
          "name": "Lister tous les patients (Annuaire)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/sec/patients",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "patients"]
            }
          }
        },
        {
          "name": "Rechercher patient par CIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/sec/patients/by-cin?cin=AB123456",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "patients", "by-cin"],
              "query": [
                {
                  "key": "cin",
                  "value": "AB123456",
                  "description": "Remplacer par un CIN existant"
                }
              ]
            }
          }
        },
        {
          "name": "Historique Consultations par CIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/sec/patients/history-by-cin?cin=AB123456",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "patients", "history-by-cin"],
              "query": [
                {
                  "key": "cin",
                  "value": "AB123456",
                  "description": "Remplacer par un CIN existant"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Gestion Administrative des Dossiers",
      "item": [
        {
          "name": "1. Ajouter un document (Upload)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Sélectionnez un fichier (PDF, JPG...)"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8081/api/sec/patients/1/documents",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "patients", "1", "documents"],
              "variable": []
            },
            "description": "N'oubliez pas de changer le '1' dans l'URL par l'ID réel du *dossierId* du patient, que vous avez récupéré dans la recherche de patient."
          }
        },
        {
          "name": "2. Lister les documents du dossier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/sec/patients/1/documents",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "patients", "1", "documents"]
            },
            "description": "Changez le '1' par le dossierId du patient."
          }
        },
        {
          "name": "3. Télécharger / Visualiser un document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/sec/documents/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "sec", "documents", "1"]
            },
            "description": "Changez le '1' à la fin de l'URL par l'ID du document que vous avez obtenu dans la liste des documents."
          }
        }
      ]
    }
  ]
}
