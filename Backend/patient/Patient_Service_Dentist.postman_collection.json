              "raw": "[\n  {\n    \"medicament\": \"Doliprane 1000mg\",\n    \"posologie\": \"1 comprimé en cas de douleur, max 3/jour\",\n    \"duree\": \"3 jours\"\n  },\n  {\n    \"medicament\": \"Amoxicilline 500mg\",\n    \"posologie\": \"1 gélule matin et soir\",\n    \"duree\": \"6 jours\"\n  }\n]"
            },
            "url": {
